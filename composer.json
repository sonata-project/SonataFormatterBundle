{
    "name": "sonata-project/formatter-bundle",
    "description": "Symfony SonataFormatterBundle",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "sonata",
        "formatter",
        "editor",
        "ckeditor"
    ],
    "authors": [
        {
            "name": "Thomas Rabaix",
            "email": "thomas.rabaix@sonata-project.org",
            "homepage": "https://sonata-project.org"
        },
        {
            "name": "Sonata Community",
            "homepage": "https://github.com/sonata-project/SonataFormatterBundle/contributors"
        }
    ],
    "homepage": "https://docs.sonata-project.org/projects/SonataFormatterBundle",
    "require": {
        "php": "^8.1",
        "friendsofsymfony/ckeditor-bundle": "^2.0",
        "psr/container": "^1.0 || ^2.0",
        "psr/log": "^2.0 || ^3.0",
        "sonata-project/block-bundle": "^4.11 || ^5.0",
        "sonata-project/form-extensions": "^1.4 || ^2.0",
        "symfony/config": "^6.4 || ^7.1",
        "symfony/dependency-injection": "^6.4 || ^7.1",
        "symfony/event-dispatcher": "^6.4 || ^7.1",
        "symfony/form": "^6.4 || ^7.1",
        "symfony/framework-bundle": "^6.4 || ^7.1",
        "symfony/http-foundation": "^6.4 || ^7.1",
        "symfony/http-kernel": "^6.4 || ^7.1",
        "symfony/options-resolver": "^6.4 || ^7.1",
        "symfony/property-access": "^6.4 || ^7.1",
        "symfony/translation": "^6.4 || ^7.1",
        "symfony/validator": "^6.4 || ^7.1",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.0.2",
        "doctrine/doctrine-bundle": "^2.11",
        "doctrine/orm": "^2.16 || ^3.0",
        "friendsofphp/php-cs-fixer": "^3.4",
        "knplabs/knp-menu-bundle": "^3.0",
        "matthiasnoback/symfony-config-test": "^6.1",
        "matthiasnoback/symfony-dependency-injection-test": "^6.1",
        "phpstan/extension-installer": "^1.0",
        "phpstan/phpdoc-parser": "^1.0",
        "phpstan/phpstan": "^1.4 || ^2.0",
        "phpstan/phpstan-phpunit": "^1.0 || ^2.0",
        "phpstan/phpstan-strict-rules": "^1.0 || ^2.0",
        "phpstan/phpstan-symfony": "^1.1 || ^2.0",
        "phpunit/phpunit": "^10.5.54 || ^11.5.38 || ^12.3.10",
        "psalm/plugin-phpunit": "^0.18 || ^0.19",
        "psalm/plugin-symfony": "^5.0",
        "rector/rector": "^1.1 || ^2.0",
        "sonata-project/admin-bundle": "^4.35.4",
        "sonata-project/classification-bundle": "^4.0",
        "sonata-project/doctrine-extensions": "^1.0 || ^2.0",
        "sonata-project/doctrine-orm-admin-bundle": "^4.0",
        "sonata-project/media-bundle": "^4.13",
        "sonata-project/twig-extensions": "^1.0 || ^2.0",
        "symfony/browser-kit": "^6.4 || ^7.1",
        "symfony/filesystem": "^6.4 || ^7.1",
        "symfony/security-bundle": "^6.4 || ^7.1",
        "symfony/yaml": "^6.4 || ^7.1",
        "vimeo/psalm": "^5.0 || ^6.10"
    },
    "conflict": {
        "sonata-project/admin-bundle": "<4.0",
        "sonata-project/classification-bundle": "<4.0",
        "sonata-project/media-bundle": "<4.2"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Sonata\\FormatterBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sonata\\FormatterBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    }
}
