parameters:
    ignoreErrors:
        - # https://github.com/phpstan/phpstan-strict-rules/issues/130
            message: '#^Call to static method PHPUnit\\Framework\\Assert::.* will always evaluate to true\.$#'
            path: tests/
        - # SandboxExtension is @internal since Twig 3.29 in favor of Twig\Sandbox\Sandbox, which requires twig/twig >= 3.29
            identifier: classConstant.internalClass
            message: '#^Access to constant on internal class Twig\\Extension\\SandboxExtension\.$#'
            paths:
                - src/DependencyInjection/Compiler/AddTwigExtensionsCompilerPass.php
                - tests/DependencyInjection/Compiler/AddTwigExtensionsCompilerPassTest.php
